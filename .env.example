# Development mode is deliberately explicit. DEMO only loads deterministic, labelled fixtures.
FORESTPROOF_MODE=demo
# The current P0 repository adapter is SQLite for a zero-credential demo run.
FORESTPROOF_SQLITE_PATH=./data/local/forestproof.db
# Reserved for the explicit PostGIS repository adapter; it is not wired in P0.
POSTGIS_DATABASE_URL=postgresql://forestproof:forestproof@db:5432/forestproof
# Informational only: explicitly bind the API to loopback in the actual launch command.
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Hosted web proxy: use a private API endpoint including /api/v1. This setting
# does not provide authentication. Leave blank for direct local development.
FORESTPROOF_API_INTERNAL_BASE_URL=

# Optional isolated synthetic owner-demo candidate only. Leave disabled for
# the current preview. Both API and web require the same independently
# generated, high-entropy internal token, injected securely at runtime.
# This authenticates the web service to the API, not the human user; the owner
# gateway and host-level loopback isolation are still required. Never put a
# real token in this file, Git, logs or chat.
# FORESTPROOF_API_MODE=owner_demo
# FORESTPROOF_INTERNAL_API_TOKEN=
# In owner_demo, the web proxy also requires the exact HTTP loopback SSH-tunnel
# gateway origin with an explicit port; missing/mismatched Origin denies POST.
# FORESTPROOF_OWNER_GATEWAY_ORIGIN=
# Optional public Copernicus scene metadata lookup for owner_demo only.
# Default: off. Scene acquisitions are not forest-disturbance alerts.
# FORESTPROOF_COPERNICUS_CATALOG_ENABLED=true

# Optional live-source credentials. Never commit actual values.
GFW_API_KEY=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
NASA_FIRMS_MAP_KEY=

# Object storage is local in development. Production must use private, encrypted storage.
EVIDENCE_STORAGE_BACKEND=local
EVIDENCE_STORAGE_PATH=./data/local/evidence
# Synthetic evidence fixtures are disabled by default. Set to true only in an
# isolated local DEMO; the operator must ensure isolation (not enforced here).
# Do not enable on a hosted preview or for personal data or real evidence.
FORESTPROOF_DEMO_EVIDENCE_UPLOADS_ENABLED=false

# Leave disabled until an AOI-specific GFW tile request and source terms are verified.
NEXT_PUBLIC_ENABLE_GFW_GLAD_S2_CONTEXT=false
NEXT_PUBLIC_GFW_GLAD_S2_TILES=https://tiles.globalforestwatch.org/umd_glad_sentinel2_alerts/latest/dynamic/{z}/{x}/{y}.png

[Unit]
Description=ForestProof Geta visibility page

[Service]
User=forestproof-visibility
Group=forestproof-visibility
WorkingDirectory=/opt/forestproof-visibility/current
StateDirectory=forestproof-visibility
StateDirectoryMode=0700
ReadOnlyPaths=/var/lib/forestproof-visibility
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m tools.sentinel_visibility.visibility_service --state /var/lib/forestproof-visibility/source.json serve --port 18450 --hostname vmi3711898.contaboserver.net
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
TasksMax=48
MemoryMax=128M

[Install]
WantedBy=multi-user.target
